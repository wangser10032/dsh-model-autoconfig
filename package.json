{
  "name": "dsh-model-autoconfig",
  "version": "0.8.1",
  "description": "dsh web 插件：监视 Settings → Models，按真值库自动配置思考档位和视觉等能力",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "llm-pi-ai",
    "reasoning-effort",
    "thinking-level",
    "model-config",
    "vision"
  ],
  "author": "wangser10032",
  "type": "module",
  "bin": {
    "dsh-mac": "./bin/dsh-mac.mjs"
  },
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./plugin": "./src/plugin.mjs",
    "./lib": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "bin",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangser10032/dsh-model-autoconfig.git"
  },
  "bugs": {
    "url": "https://github.com/wangser10032/dsh-model-autoconfig/issues"
  },
  "homepage": "https://github.com/wangser10032/dsh-model-autoconfig#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-credentials": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "license": "MIT"
}
