{
  "name": "dsh-model-autoconfig",
  "version": "0.11.0",
  "description": "dsh web 插件：自动配置模型思考档位与能力，并按 provider+model 记住最后选择的思考档位",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "llm-pi-ai",
    "reasoning-effort",
    "thinking-level",
    "model-config",
    "vision"
  ],
  "author": "wangser10032",
  "type": "module",
  "bin": {
    "dsh-mac": "bin/dsh-mac.mjs"
  },
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./plugin": "./src/plugin.mjs",
    "./client": "./lib/client.js",
    "./lib": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "lib",
    "bin",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/client.js && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangser10032/dsh-model-autoconfig.git"
  },
  "bugs": {
    "url": "https://github.com/wangser10032/dsh-model-autoconfig/issues"
  },
  "homepage": "https://github.com/wangser10032/dsh-model-autoconfig#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.0.1-rc.5 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    }
  },
  "license": "MIT"
}
